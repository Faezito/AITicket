{
    "swagger": "2.0",
    "info": {
        "description": "API para comunicação com modelos de IA locais através do Ollama.",
        "title": "AI Ticket API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Matheus"
        },
        "license": {
            "name": "MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/ask": {
            "post": {
                "description": "Envia uma pergunta para o modelo local através do Ollama e retorna a resposta gerada.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "Enviar pergunta para IA",
                "parameters": [
                    {
                        "description": "Dados da solicitação",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dtos.AskRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Resposta gerada com sucesso",
                        "schema": {
                            "$ref": "#/definitions/dtos.AskResponse"
                        }
                    },
                    "400": {
                        "description": "JSON inválido ou campos obrigatórios ausentes",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Request ID já está em uso",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "499": {
                        "description": "Geração cancelada",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Erro na comunicação com Ollama",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "504": {
                        "description": "Tempo limite excedido",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/cancel": {
            "post": {
                "description": "Cancela uma geração em andamento com base no Request ID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "AI"
                ],
                "summary": "Cancelar requisição",
                "parameters": [
                    {
                        "description": "Identificador da requisição",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dtos.CancelRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Geração cancelada",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Request ID obrigatório",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Nenhuma geração em andamento com esse ID",
                        "schema": {
                            "$ref": "#/definitions/dtos.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dtos.AskRequest": {
            "type": "object",
            "properties": {
                "model": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                }
            }
        },
        "dtos.AskResponse": {
            "type": "object",
            "properties": {
                "answer": {
                    "type": "string"
                },
                "duration_ms": {
                    "type": "integer"
                },
                "model": {
                    "type": "string"
                },
                "request_id": {
                    "type": "string"
                }
            }
        },
        "dtos.CancelRequest": {
            "type": "object",
            "properties": {
                "request_id": {
                    "type": "string"
                }
            }
        },
        "dtos.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        }
    }
}